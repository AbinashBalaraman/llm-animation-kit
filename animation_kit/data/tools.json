  {
    "name": "create_project",
    "description": "Create a new authored story from the actual user brief and custom vector artwork. No default character or environment.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
